# --- Datasets & virtual envs ---
datasets/
.venv/
venv/

# --- Torch training artefacts (large; reproducible from scripts) ---
scripts/torch_runs/*.pt
scripts/torch_runs/ckpt_*.pt
scripts/torch_runs/model_final_*.pt

# --- Torch/ONNX export outputs (timestamped; rebuildable) ---
scripts/torch_runs/outputs/ts_*/
scripts/torch_runs/outputs/onnx_*/
scripts/torch_runs/outputs/onnx_2025090*/

# --- Evaluation outputs (timestamped) ---
scripts/torch_runs/eval_*/
scripts/torch_runs/eval*

# --- Per-epoch metrics CSVs from training ---
scripts/torch_runs/metrics_*.csv

# --- Python build/cache artefacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info
*.egg-info/
*.bak
build/
dist/
.eggs/

# --- Test/lint/type-check caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editor / IDE ---
.idea/
.vscode/
*.swp
.DS_Store

# --- Runtime logs ---
*.log
logs/